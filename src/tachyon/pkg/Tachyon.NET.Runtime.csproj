<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <PackageId>Tachyon.NET.Runtime</PackageId>
    <Authors>Rew</Authors>
    <Description>Tachyon .NET managed runtime framework - CoreLib and managed framework libraries for the Tachyon embedded runtime (x86).</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <!-- Don't compile anything - this is a packaging-only project -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <EnableDefaultItems>false</EnableDefaultItems>
    <NoWarn>NU5128;NU5131</NoWarn>

    <!-- Derive artifact paths from repo root -->
    <RepoRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', '..'))</RepoRoot>
    <ArtifactsDir>$([MSBuild]::NormalizeDirectory('$(RepoRoot)', 'artifacts'))</ArtifactsDir>
    <TachyonArch Condition="'$(TachyonArch)' == ''">x86</TachyonArch>
    <TachyonConfig Condition="'$(TachyonConfig)' == ''">Debug</TachyonConfig>
    <PackageVersion Condition="'$(PackageVersion)' == ''">9.0.0-dev</PackageVersion>

    <TachyonRuntimeDir>$(ArtifactsDir)bin\runtime\net9.0-tachyon-$(TachyonConfig)-$(TachyonArch)\</TachyonRuntimeDir>
    <TachyonCorelibDir>$(ArtifactsDir)bin\coreclr\tachyon.$(TachyonArch).$(TachyonConfig)\IL\</TachyonCorelibDir>
    <TachyonRefDir>$(ArtifactsDir)bin\microsoft.netcore.app.ref\ref\net9.0\</TachyonRefDir>
  </PropertyGroup>

  <!-- Implementation assemblies: CoreLib + all framework libs -->
  <ItemGroup>
    <None Include="$(TachyonRuntimeDir)*.dll" Pack="true" PackagePath="runtimes/tachyon-x86/lib/net9.0/" />
    <None Include="$(TachyonCorelibDir)System.Private.CoreLib.dll" Pack="true" PackagePath="runtimes/tachyon-x86/lib/net9.0/" />
  </ItemGroup>

  <!-- Reference assemblies for compilation -->
  <ItemGroup>
    <None Include="$(TachyonRefDir)*.dll" Pack="true" PackagePath="ref/net9.0/" />
  </ItemGroup>

</Project>
